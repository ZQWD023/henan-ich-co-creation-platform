# ===== 服务配置 =====
PORT=3000
NODE_ENV=development

# ===== 安全（必改）=====
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-me-to-a-32-chars-random-string
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址，多个用英文逗号分隔；生产建议写死，不要用 *
CORS_ORIGIN=*

# ===== 数据库 =====
# 留空则使用项目根目录 database.sqlite
DATABASE_PATH=

# ===== 文件上传 =====
UPLOAD_MAX_BYTES=5242880

# ===== 一键运行（双击 启动网站.bat 即可）=====
# 启动后自动打开浏览器访问网站首页；设为 0 可关闭
AUTO_OPEN_BROWSER=1
# 首次运行时自动导入非遗数据与共创演示数据；设为 0 可关闭
AUTO_SETUP=1

# ===== 接口限流（15 分钟窗口内的最大请求数）=====
RATE_LIMIT_MAX=600

# ===== AI（阿里云百炼 / DashScope 通义千问）=====
# 获取地址：https://bailian.console.aliyun.com/  或  https://dashscope.console.aliyun.com/
# 不填也能跑，AI 接口会自动降级为规则兜底，不会报错崩页面
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo
