# ============================================================
#  环境变量模板 —— 河南省非物质文化遗产共创平台 v2.1
#
#  用法：复制本文件为同目录下的 .env，按需修改
#     Windows：    copy backend\.env.example backend\.env
#     macOS/Linux：cp backend/.env.example backend/.env
#
#  约定：标注【必改】的项在公网/生产部署时必须改；
#        标注【可选】的不填即用默认值，不填也能正常启动。
# ============================================================

# ---------------- 服务 ----------------
# 后端监听端口（前端与后端同源，一般不用改）
PORT=3000
# development / production；production 下静态资源启用长缓存
NODE_ENV=development

# ---------------- 安全【必改】----------------
# JWT 签名密钥。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 公网部署务必替换默认值，否则登录态可被伪造
JWT_SECRET=please-change-me-to-a-32-chars-random-string
# 登录态有效期，如 7d / 12h / 30m
JWT_EXPIRES_IN=7d
# 允许的来源，多个用英文逗号分隔；生产建议写死域名，不要用 *
CORS_ORIGIN=*
# 接口限流：15 分钟窗口内同一 IP 的最大请求数（登录/注册接口另有更严限制）
RATE_LIMIT_MAX=600

# ---------------- 数据库 ----------------
# SQLite 文件路径；留空 = 项目根目录 database.sqlite
DATABASE_PATH=

# ---------------- 文件上传 ----------------
# 上传目录；留空 = backend/uploads
UPLOAD_DIR=
# 单个文件最大字节数（默认 5 MB）
UPLOAD_MAX_BYTES=5242880

# ---------------- 一键运行（双击 启动网站.bat 时生效）----------------
# 启动后自动打开浏览器访问首页；0 = 关闭
AUTO_OPEN_BROWSER=1
# 首次运行自动建表 + 导入非遗数据 + 演示共创数据；0 = 只建表不灌数据
AUTO_SETUP=1

# ---------------- AI：通义千问（阿里云百炼 / DashScope）【可选】----------------
# 获取地址：https://bailian.console.aliyun.com/
# 不填也能跑：AI 接口自动降级为规则兜底，页面不会报错
QWEN_API_KEY=
# 模型名：qwen-turbo（快）/ qwen-plus（更强）/ qwen-max
QWEN_MODEL=qwen-turbo
# 自定义网关地址；默认走阿里云官方地址，用代理或自建服务时填写
QWEN_BASE_URL=
# OpenAI 兼容模式地址（部分中转/自建服务需要，形如 https://xxx/v1）
QWEN_COMPAT_URL=

# ---------------- Agent 规划器【可选】----------------
# auto = 配了 Key 走大模型自主选工具，没 Key 走规则（推荐）
# llm  = 强制大模型规划（无 Key 会失败）
# rules= 强制规则规划（离线演示 / 评测复现用）
AGENT_PLANNER=auto

# ---------------- 开发与评测脚本专用【可选，勿写入生产】----------------
# 1 = 跑 RAG 评测时不覆盖写 backend/docs/rag-eval-report.md
EVAL_NO_WRITE=
# 冒烟测试目标地址前缀（默认 http://localhost:3000）
SMOKE_BASE=
