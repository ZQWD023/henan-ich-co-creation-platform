{
  "openapi": "3.0.3",
  "info": {
    "title": "河南省非遗共创平台 · 后端 API",
    "version": "2.0.0",
    "description": "传智杯 AI Web 赛道参赛作品。围绕「非遗内容沉淀 + 多人协作共创 + 社区互动传播」三场景，共创模块为核心差异化能力。\n\n**认证方式**：先调 `/api/auth/login` 拿到 token，再点右上角 Authorize 填入（无需加 Bearer 前缀）。\n\n**统一响应**：`{ code, message, data }`，code=0 为成功。"
  },
  "servers": [{ "url": "/api", "description": "当前服务" }],
  "tags": [
    { "name": "认证", "description": "注册 / 登录 / 改密 / 找回" },
    { "name": "内容库", "description": "分类、非遗项目、传承人、素材、活动、资讯" },
    { "name": "共创协作", "description": "核心：项目生命周期 / 成员 / 任务 / 版本 / 讨论" },
    { "name": "作品", "description": "发布、上下架、点赞、收藏" },
    { "name": "社区", "description": "评论、通用互动、话题、通知" },
    { "name": "管理后台", "description": "审核、用户管理、数据看板" },
    { "name": "AI", "description": "问答、文案生成、纹样建议、语义搜索、推荐" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "message": { "type": "string", "example": "ok" },
          "data": { "nullable": true }
        }
      },
      "PageResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "list": { "type": "array", "items": { "type": "object" } },
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "pageSize": { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["认证"], "summary": "注册",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["username", "email", "password"],
            "properties": {
              "username": { "type": "string", "minLength": 3, "maxLength": 20, "example": "xiaolin" },
              "email": { "type": "string", "example": "xiaolin@example.com" },
              "password": { "type": "string", "minLength": 6, "example": "123456" }
            }
          } } }
        },
        "responses": { "201": { "description": "返回 token 与 user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Response" } } } } }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["认证"], "summary": "登录（演示账号 admin/creator/user，密码 123456）",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object", "required": ["username", "password"],
            "properties": { "username": { "type": "string", "example": "admin" }, "password": { "type": "string", "example": "123456" } }
          } } }
        },
        "responses": { "200": { "description": "登录成功" } }
      }
    },
    "/auth/me": {
      "get": { "tags": ["认证"], "summary": "当前用户完整信息（含统计与成就）", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "ok" } } }
    },
    "/auth/password": {
      "put": {
        "tags": ["认证"], "summary": "修改密码（校验旧密码）", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["oldPassword", "newPassword"],
          "properties": { "oldPassword": { "type": "string" }, "newPassword": { "type": "string", "minLength": 6 } }
        } } } },
        "responses": { "200": { "description": "已修改" } }
      }
    },
    "/auth/forgot-password": {
      "post": { "tags": ["认证"], "summary": "申请重置令牌", "responses": { "200": { "description": "返回 resetToken" } } }
    },
    "/auth/reset-password": {
      "post": { "tags": ["认证"], "summary": "用令牌重置密码", "responses": { "200": { "description": "已重置" } } }
    },
    "/users/me": {
      "put": {
        "tags": ["认证"], "summary": "修改个人资料", "security": [{ "bearerAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": {
          "type": "object", "properties": { "displayName": { "type": "string" }, "bio": { "type": "string" }, "avatar": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users/{userId}": {
      "get": { "tags": ["认证"], "summary": "用户公开主页", "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/users/me/certification": {
      "post": {
        "tags": ["认证"], "summary": "提交传承人认证", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["realName"],
          "properties": { "realName": { "type": "string" }, "heritageId": { "type": "string" }, "level": { "type": "string", "enum": ["国家级", "省级", "市级", "县级"] }, "intro": { "type": "string" }, "materialUrl": { "type": "string" } }
        } } } },
        "responses": { "201": { "description": "已提交" } }
      },
      "get": { "tags": ["认证"], "summary": "我的认证状态", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "ok" } } }
    },
    "/users/{userId}/follow": {
      "post": { "tags": ["社区"], "summary": "关注用户", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["社区"], "summary": "取消关注", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/content/categories": {
      "get": { "tags": ["内容库"], "summary": "非遗分类（含各类项目数）", "responses": { "200": { "description": "ok" } } }
    },
    "/content/heritage": {
      "get": {
        "tags": ["内容库"], "summary": "非遗项目列表（多条件筛选 + 分页）",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "分类 ID" },
          { "name": "region", "in": "query", "schema": { "type": "string" }, "description": "地区（模糊）" },
          { "name": "level", "in": "query", "schema": { "type": "string" }, "description": "国家级/省级…" },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["popularity", "newest", "likes", "name"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResponse" } } } } }
      }
    },
    "/content/heritage/{id}": {
      "get": { "tags": ["内容库"], "summary": "非遗项目详情（含传承人与相关推荐）", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/content/heritage/regions": {
      "get": { "tags": ["内容库"], "summary": "地区下拉选项", "responses": { "200": { "description": "ok" } } }
    },
    "/content/inheritors": {
      "get": { "tags": ["内容库"], "summary": "传承人列表", "parameters": [{ "name": "heritageId", "in": "query", "schema": { "type": "string" } }, { "name": "keyword", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/content/materials": {
      "get": { "tags": ["内容库"], "summary": "公共素材库（纹样/音效/资料）", "parameters": [{ "name": "type", "in": "query", "schema": { "type": "string", "enum": ["pattern", "audio", "doc"] } }], "responses": { "200": { "description": "ok" } } },
      "post": {
        "tags": ["内容库"], "summary": "上传素材", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["title", "fileUrl"],
          "properties": { "title": { "type": "string" }, "fileUrl": { "type": "string" }, "type": { "type": "string", "enum": ["pattern", "audio", "doc"] }, "heritageId": { "type": "string" } }
        } } } },
        "responses": { "201": { "description": "ok" } }
      }
    },
    "/content/events": {
      "get": { "tags": ["内容库"], "summary": "非遗活动列表", "responses": { "200": { "description": "ok" } } }
    },
    "/content/events/{id}/signup": {
      "post": {
        "tags": ["内容库"], "summary": "活动报名", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["realName", "phone"],
          "properties": { "realName": { "type": "string" }, "phone": { "type": "string", "example": "13800138000" }, "notes": { "type": "string" } }
        } } } },
        "responses": { "201": { "description": "报名成功" } }
      }
    },
    "/projects/meta": {
      "get": { "tags": ["共创协作"], "summary": "状态机与状态文字（前端渲染流程条用）", "responses": { "200": { "description": "ok" } } }
    },
    "/projects": {
      "get": {
        "tags": ["共创协作"], "summary": "共创项目列表",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["draft", "recruiting", "in_progress", "reviewing", "closed", "cancelled"] } },
          { "name": "heritageId", "in": "query", "schema": { "type": "string" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "hot", "deadline"] } },
          { "name": "mine", "in": "query", "schema": { "type": "string", "enum": ["owned", "joined"] } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "tags": ["共创协作"], "summary": "发起共创项目（需已认证创作者）", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["title"],
          "properties": {
            "title": { "type": "string", "example": "豫剧脸谱文创共创" },
            "description": { "type": "string", "example": "以豫剧脸谱为母题做一组当代文创，需要设计与文案各一名。" },
            "recruitNeed": { "type": "string" },
            "heritageId": { "type": "string" },
            "memberLimit": { "type": "integer", "default": 10 },
            "deadline": { "type": "string", "format": "date-time" },
            "publish": { "type": "boolean", "default": false, "description": "true 则直接进入 recruiting" }
          }
        } } } },
        "responses": { "201": { "description": "创建成功" } }
      }
    },
    "/projects/{id}": {
      "get": { "tags": ["共创协作"], "summary": "项目详情（成员/任务/版本/我的身份）", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "put": { "tags": ["共创协作"], "summary": "编辑项目（发起人/管理员）", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/projects/{id}/status": {
      "patch": {
        "tags": ["共创协作"], "summary": "状态流转（含前置条件校验）", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["status"],
          "properties": { "status": { "type": "string", "enum": ["recruiting", "in_progress", "reviewing", "closed", "cancelled"] }, "note": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "ok" }, "409": { "description": "非法流转或前置条件不满足" } }
      }
    },
    "/projects/{id}/apply": {
      "post": {
        "tags": ["共创协作"], "summary": "申请加入项目", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": {
          "type": "object", "properties": { "role": { "type": "string", "example": "视觉设计" }, "reason": { "type": "string" } }
        } } } },
        "responses": { "201": { "description": "已提交" } }
      }
    },
    "/projects/{id}/members/{userId}": {
      "patch": {
        "tags": ["共创协作"], "summary": "审核成员申请", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["decision"],
          "properties": { "decision": { "type": "string", "enum": ["approved", "rejected"] }, "note": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "tags": ["共创协作"], "summary": "移除成员", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/projects/{id}/tasks": {
      "get": { "tags": ["共创协作"], "summary": "任务列表（成员可见）", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "post": {
        "tags": ["共创协作"], "summary": "创建任务并指派", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["title"],
          "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "assigneeId": { "type": "string" }, "deadline": { "type": "string", "format": "date-time" } }
        } } } },
        "responses": { "201": { "description": "ok" } }
      }
    },
    "/projects/tasks/{taskId}": {
      "patch": {
        "tags": ["共创协作"], "summary": "更新任务进度 / 提交阶段成果 / 验收", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": {
          "type": "object",
          "properties": { "status": { "type": "string", "enum": ["todo", "doing", "review", "done"] }, "progress": { "type": "integer", "minimum": 0, "maximum": 100 }, "submitContent": { "type": "string" }, "assigneeId": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "ok" }, "403": { "description": "负责人不能自行验收" } }
      }
    },
    "/projects/{id}/versions": {
      "get": { "tags": ["共创协作"], "summary": "成果版本列表（历史回溯）", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "post": {
        "tags": ["共创协作"], "summary": "提交成果版本", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["title"],
          "properties": { "title": { "type": "string" }, "content": { "type": "string" }, "fileUrl": { "type": "string" }, "coverUrl": { "type": "string" } }
        } } } },
        "responses": { "201": { "description": "ok" } }
      }
    },
    "/projects/{id}/versions/{versionId}/final": {
      "post": { "tags": ["共创协作"], "summary": "指定最终版本", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "versionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/projects/{id}/discussions": {
      "get": { "tags": ["共创协作"], "summary": "项目内讨论列表", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "post": {
        "tags": ["共创协作"], "summary": "发讨论（支持 @成员 与回复）", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["content"],
          "properties": { "content": { "type": "string" }, "replyTo": { "type": "string" }, "mentions": { "type": "array", "items": { "type": "string" } } }
        } } } },
        "responses": { "201": { "description": "ok" } }
      }
    },
    "/projects/workspace/me": {
      "get": { "tags": ["共创协作"], "summary": "我的工作台（我发起的/我参与的/待审申请/待办任务）", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "ok" } } }
    },
    "/works": {
      "get": { "tags": ["作品"], "summary": "作品列表", "parameters": [{ "name": "heritageId", "in": "query", "schema": { "type": "string" } }, { "name": "projectId", "in": "query", "schema": { "type": "string" } }, { "name": "workType", "in": "query", "schema": { "type": "string" } }, { "name": "keyword", "in": "query", "schema": { "type": "string" } }, { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "hot", "views"] } }], "responses": { "200": { "description": "ok" } } },
      "post": {
        "tags": ["作品"], "summary": "发布作品（普通用户需审核，认证创作者直接通过）", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["title"],
          "properties": { "title": { "type": "string" }, "summary": { "type": "string" }, "workType": { "type": "string" }, "heritageId": { "type": "string" }, "projectId": { "type": "string" }, "coverUrl": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "topics": { "type": "array", "items": { "type": "string" } } }
        } } } },
        "responses": { "201": { "description": "ok" } }
      }
    },
    "/works/{id}": {
      "get": { "tags": ["作品"], "summary": "作品详情（含已赞/已收藏状态）", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/works/{id}/like": {
      "post": { "tags": ["作品"], "summary": "点赞作品", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["作品"], "summary": "取消点赞", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/works/{id}/favorite": {
      "post": { "tags": ["作品"], "summary": "收藏作品", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } },
      "delete": { "tags": ["作品"], "summary": "取消收藏", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/comments": {
