{
  "name": "ich-co-creation-backend",
  "version": "2.0.0",
  "description": "河南省非遗共创平台后端 API（传智杯 AI Web 赛道）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node db/bootstrap.js",
    "seed": "node db/seed.js",
    "demo": "node scripts/demo-data.js && node scripts/demo-social.js",
    "import-data": "node db/import-data.js",
    "reset": "node -e \"require('fs').rmSync('database.sqlite',{force:true});require('fs').rmSync('database.sqlite-wal',{force:true});require('fs').rmSync('database.sqlite-shm',{force:true});console.log('数据库已清空')\"",
    "smoke": "node scripts/smoke-test.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "demo:social": "node scripts/demo-social.js"
  },
  "keywords": [
    "ich",
    "intangible-cultural-heritage",
    "co-creation",
    "express",
    "sqlite",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
