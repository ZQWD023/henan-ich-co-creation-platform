{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "none",
    "moduleDetection": "auto",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["算法网站(3)/js/globals.d.ts", "算法网站(3)/js/ai-client.js", "算法网站(3)/js/vision-search.js", "算法网站(3)/js/pattern-generator.js", "算法网站(3)/js/offline-store.js"],
  "exclude": ["node_modules", "backend"]
}
